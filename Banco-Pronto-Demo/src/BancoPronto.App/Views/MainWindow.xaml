<Window x:Class="BancoPronto.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BancoPronto.App.ViewModels"
        xmlns:conv="clr-namespace:BancoPronto.App.Converters"
        xmlns:controls="clr-namespace:BancoPronto.App.Views.Controls"
        xmlns:models="clr-namespace:BancoPronto.Core.Models;assembly=BancoPronto.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Banco Pronto Demo"
        Width="1180" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Branding/app.ico"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Text}"
        FontSize="14">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Barra lateral ================= -->
        <Border Background="{DynamicResource Brush.Sidebar.Background}">
            <DockPanel Margin="18,24,18,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,0">
                    <controls:BrandLogo Width="38" Height="38" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Banco Pronto" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Sidebar.Text}" />
                        <TextBlock Text="Versão de demonstração" FontSize="12" Foreground="{DynamicResource Brush.Sidebar.TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Top" Margin="0,30,0,0" CornerRadius="4" Padding="12,10"
                        Background="{DynamicResource Brush.Sidebar.ItemSelected}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEE94;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="Preparar banco" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Sidebar.Text}" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource Button.Sidebar}" Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" Style="{StaticResource Text.Icon}" />
                            <TextBlock Text="{Binding ThemeToggleText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding VersionText}" Margin="12,16,0,0" FontSize="12" Foreground="{DynamicResource Brush.Sidebar.TextMuted}" />
                    <TextBlock Text="TSCBr · dados fictícios" Margin="12,2,0,0" FontSize="12" Foreground="{DynamicResource Brush.Sidebar.TextMuted}" />
                </StackPanel>

                <Border />
            </DockPanel>
        </Border>

        <!-- ================= Conteúdo ================= -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,34,40,32" MaxWidth="1000">
                <TextBlock Text="Preparar banco" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.Subtitle}"
                           Text="Selecione a pasta dos backups: o Banco Pronto identifica o completo e as modificações, aplica tudo em ordem e valida o resultado. Os arquivos originais nunca são alterados." />

                <!-- Aviso de demonstração -->
                <Border Margin="0,20,0,0" CornerRadius="6" Padding="16,12" Background="{DynamicResource Brush.AccentSubtle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" VerticalAlignment="Top" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Text.Secondary}">
                            <Run Text="Versão de demonstração." FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                            <Run Text="Usa arquivos fictícios (.backup) e simula a extração e a aplicação dos logs. A aplicação utilizada em ambiente real possui componentes e integrações que não fazem parte deste repositório." />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Etapas -->
                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,26,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepItemViewModel}">
                            <StackPanel Margin="0,0,12,0">
                                <Border x:Name="StepBar" Height="4" CornerRadius="2" Background="{DynamicResource Brush.Track}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border x:Name="StepBadge" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Brush.Track}">
                                        <Grid>
                                            <TextBlock x:Name="StepNumber" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <TextBlock x:Name="StepCheck" Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="12"
                                                       HorizontalAlignment="Center" Visibility="Collapsed"
                                                       Foreground="{DynamicResource Brush.Text.OnAccent}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="StepTitle" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                </StackPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Active">
                                    <Setter TargetName="StepBar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                    <Setter TargetName="StepBadge" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                    <Setter TargetName="StepNumber" Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                    <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                    <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="StepBar" Property="Background" Value="{DynamicResource Brush.Success}" />
                                    <Setter TargetName="StepBadge" Property="Background" Value="{DynamicResource Brush.Success}" />
                                    <Setter TargetName="StepNumber" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="StepCheck" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter TargetName="StepBar" Property="Background" Value="{DynamicResource Brush.Error}" />
                                    <Setter TargetName="StepBadge" Property="Background" Value="{DynamicResource Brush.Error}" />
                                    <Setter TargetName="StepNumber" Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                    <Setter TargetName="StepTitle" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Pasta -->
                <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Pasta dos backups" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                   Text="Arquivos no padrão &lt;BANCO&gt;_&lt;aaaaMMdd&gt;_&lt;HHmm&gt;_&lt;C|M&gt;.backup. A pasta é apenas lida." />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Padding="12,9" BorderThickness="1"
                                    Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}">
                                <TextBlock Text="{Binding FolderDisplay}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0" Command="{Binding SelectFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" Style="{StaticResource Text.Icon}" />
                                    <TextBlock Text="Selecionar pasta" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Margin="10,0,0,0" Command="{Binding UseDemoDataCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Text.Icon}" />
                                    <TextBlock Text="Usar dados de demonstração" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Verificação -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScanSummary}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="Backups identificados" Style="{StaticResource Text.SectionTitle}" />
                        </DockPanel>

                        <Grid Margin="0,16,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ORDEM" Style="{StaticResource Text.Overline}" />
                            <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource Text.Overline}" />
                            <TextBlock Grid.Column="2" Text="ARQUIVO" Style="{StaticResource Text.Overline}" />
                            <TextBlock Grid.Column="3" Text="DATA/HORA" Style="{StaticResource Text.Overline}" />
                            <TextBlock Grid.Column="4" Text="TAMANHO" Style="{StaticResource Text.Overline}" HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Backups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupItemViewModel}">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Order}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <Border x:Name="KindPill" Grid.Column="1" Style="{StaticResource Pill}" Background="{DynamicResource Brush.AccentSubtle}">
                                                <TextBlock x:Name="KindLabel" Text="{Binding KindText}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="FileNameLabel" Text="{Binding FileName}" Style="{StaticResource Text.Mono}"
                                                           Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}"
                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding TimestampText}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <TextBlock Grid.Column="4" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Modification">
                                            <Setter TargetName="KindPill" Property="Background" Value="{DynamicResource Brush.InfoSubtle}" />
                                            <Setter TargetName="KindLabel" Property="Foreground" Value="{DynamicResource Brush.Info}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Ignored">
                                            <Setter TargetName="KindPill" Property="Background" Value="{DynamicResource Brush.Track}" />
                                            <Setter TargetName="KindLabel" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                            <Setter TargetName="FileNameLabel" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ScanResult.Issues}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ScanIssue}">
                                    <Border x:Name="IssueRoot" CornerRadius="4" Padding="12,8" Margin="0,6,0,0" Background="{DynamicResource Brush.InfoSubtle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="IssueIcon" Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="14"
                                                       VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource Brush.Info}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Text.Body}" FontSize="13.5">
                                                <Run Text="{Binding Message, Mode=OneWay}" />
                                                <Run Text="{Binding FileName, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" FontSize="12.5"
                                                     Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter TargetName="IssueRoot" Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                            <Setter TargetName="IssueIcon" Property="Text" Value="&#xE7BA;" />
                                            <Setter TargetName="IssueIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter TargetName="IssueRoot" Property="Background" Value="{DynamicResource Brush.ErrorSubtle}" />
                                            <Setter TargetName="IssueIcon" Property="Text" Value="&#xEA39;" />
                                            <Setter TargetName="IssueIcon" Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Preparação -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Preparação" Style="{StaticResource Text.SectionTitle}" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource Button.Secondary}" Margin="0,0,10,0" Command="{Binding PrepareCancelCommand}"
                                        Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="13" />
                                        <TextBlock Text="Cancelar" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Primary}" Padding="20,10" Command="{Binding PrepareCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" Style="{StaticResource Text.Icon}" />
                                        <TextBlock Text="Preparar banco" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Style="{StaticResource Progress.Bar}" Value="{Binding ProgressPercent, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Log}" Margin="0,14,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogLine}">
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="13.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Resultado: banco pronto -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{DynamicResource Brush.Success}"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.SuccessSubtle}">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="18" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Success}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Banco preparado" Style="{StaticResource Text.SectionTitle}" />
                                <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="VALIDAÇÃO" Style="{StaticResource Text.Overline}" Margin="0,18,0,4" />
                        <ItemsControl ItemsSource="{Binding ResultChecks}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.Success}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0,0,0" Style="{StaticResource Text.Body}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="BANCO PREPARADO (FICTÍCIO)" Style="{StaticResource Text.Overline}" Margin="0,18,0,6" />
                        <Border CornerRadius="4" Padding="12,9" BorderThickness="1"
                                Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}">
                            <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DatabasePath}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenWorkFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" Style="{StaticResource Text.Icon}" />
                                    <TextBlock Text="Abrir pasta de trabalho" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Command="{Binding CopyDatabasePathCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Text.Icon}" />
                                    <TextBlock Text="Copiar caminho" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Resultado: falha -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderBrush="{DynamicResource Brush.Error}"
                        Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.ErrorSubtle}">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="16" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Error}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Não foi possível preparar o banco" Style="{StaticResource Text.SectionTitle}" />
                                <TextBlock Text="Os backups originais não foram alterados. Corrija o problema e prepare novamente."
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ResultProblems}" Margin="0,14,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEA39;" Style="{StaticResource Text.Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.Error}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0,0,0" Style="{StaticResource Text.Body}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
