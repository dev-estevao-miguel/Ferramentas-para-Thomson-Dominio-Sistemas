<!-- Tokens de cor do tema claro. Identidade compartilhada com o BancoPronto: cinzas neutros + laranja #D64000. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Superfícies -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F5F4F2" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FAF9F8" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#EFEEEC" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E3E1DE" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C8C5C0" />
    <SolidColorBrush x:Key="Brush.Track" Color="#E8E6E3" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C8C5C0" />

    <!-- Texto -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1C1B1A" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5A5754" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#77736E" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Marca (laranja #D64000, identidade visual TSCBr) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#D64000" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#B83700" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#9C2E00" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#FBEEE7" />

    <!-- Estados -->
    <SolidColorBrush x:Key="Brush.Success" Color="#1E7A3C" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#E8F3EB" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#9A5B00" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#FDF2DE" />
    <SolidColorBrush x:Key="Brush.Error" Color="#C0281B" />
    <SolidColorBrush x:Key="Brush.ErrorSubtle" Color="#FBEAE8" />
    <SolidColorBrush x:Key="Brush.Info" Color="#1F5FBF" />
    <SolidColorBrush x:Key="Brush.InfoSubtle" Color="#EAF0FA" />

    <!-- Sidebar (escura nos dois temas) -->
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#1C1B1A" />
    <SolidColorBrush x:Key="Brush.Sidebar.Text" Color="#C4C0BB" />
    <SolidColorBrush x:Key="Brush.Sidebar.TextMuted" Color="#8E8A85" />
    <SolidColorBrush x:Key="Brush.Sidebar.ItemHover" Color="#262523" />
    <SolidColorBrush x:Key="Brush.Sidebar.ItemSelected" Color="#2E2C2A" />
    <SolidColorBrush x:Key="Brush.Sidebar.Divider" Color="#2A2927" />

    <!-- Desabilitado -->
    <SolidColorBrush x:Key="Brush.Disabled.Background" Color="#ECEAE7" />
    <SolidColorBrush x:Key="Brush.Disabled.Text" Color="#A19D97" />

    <!-- Console de logs -->
    <SolidColorBrush x:Key="Brush.Log.Background" Color="#1C1B1A" />
    <SolidColorBrush x:Key="Brush.Log.Text" Color="#D6D3CF" />
    <SolidColorBrush x:Key="Brush.Log.Muted" Color="#7C7873" />
    <SolidColorBrush x:Key="Brush.Log.Warning" Color="#F2B84B" />
    <SolidColorBrush x:Key="Brush.Log.Error" Color="#FF7B6E" />

    <Color x:Key="Color.Shadow">#1C1B1A</Color>
</ResourceDictionary>
