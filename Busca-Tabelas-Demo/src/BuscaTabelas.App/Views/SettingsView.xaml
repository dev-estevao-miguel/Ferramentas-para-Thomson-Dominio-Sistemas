<UserControl x:Class="BuscaTabelas.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BuscaTabelas.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1030" d:DesignHeight="1100">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="FieldButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,34,40,24" MaxWidth="1120">
                <TextBlock Text="Configurações" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="Aparência, catálogos, coletor e pesquisa." Style="{StaticResource Text.PageSubtitle}" />

                <!-- Aparência -->
                <Border Style="{StaticResource SectionCard}" Margin="0,28,0,0">
                    <StackPanel>
                        <TextBlock Text="Aparência" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Tema" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
                        <Border Style="{StaticResource Segmented.Container}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Claro" Style="{StaticResource Segmented.Item}" GroupName="Theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Light}" />
                                <RadioButton Content="Escuro" Style="{StaticResource Segmented.Item}" GroupName="Theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=Dark}" />
                                <RadioButton Content="Sistema" Style="{StaticResource Segmented.Item}" GroupName="Theme"
                                             IsChecked="{Binding Theme, Converter={StaticResource EnumToBoolean}, ConverterParameter=System}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Catálogos -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Catálogos" Style="{StaticResource Text.SectionTitle}" />

                        <TextBlock Text="Pasta dos catálogos" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CatalogsFolder, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding CatalogsFolderPlaceholder}" />
                            <Button Grid.Column="1" Content="Procurar..." Style="{StaticResource FieldButton}" Command="{Binding BrowseCatalogsFolderCommand}" />
                        </Grid>
                        <TextBlock Text="Onde o coletor grava as exportações (uma subpasta por exportação) e de onde o B.T abre a mais recente. Deixe em branco para usar o padrão."
                                   Style="{StaticResource FieldHint}" />

                        <CheckBox Content="Abrir o catálogo mais recente ao iniciar" IsChecked="{Binding OpenLatestCatalogOnStartup}" Margin="0,18,0,0" />
                        <TextBlock Text="Sem nenhuma exportação, o B.T abre o catálogo fictício de demonstração." Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </Border>

                <!-- Coletor -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Coletor ODBC" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Valores sugeridos em Atualizar catálogo. A senha nunca é gravada." Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />

                        <CheckBox Content="Habilitar exportação via ODBC" IsChecked="{Binding CollectorEnabled}" Margin="0,18,0,0" />
                        <TextBlock Text="Desabilitada por padrão: a demonstração funciona só com o catálogo fictício, sem ler conexões do Windows nem conectar a nenhum banco."
                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" />

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Conexão ODBC (DSN)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CollectorDsn, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: DSN_EXEMPLO" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Usuário" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CollectorUser, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: USUARIO_EXEMPLO" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Esquema" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CollectorSchema, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: DBA" />
                                <TextBlock Text="Proprietário das tabelas a exportar." Style="{StaticResource FieldHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tempo limite por consulta (segundos)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CollectorTimeout, UpdateSourceTrigger=PropertyChanged}" Tag="120" />
                                <TextBlock Text="De 1 a 300. O catálogo completo pode levar mais de um minuto." Style="{StaticResource FieldHint}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Pesquisa -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Pesquisa" Style="{StaticResource Text.SectionTitle}" />
                        <TextBlock Text="Limite de resultados exibidos" Style="{StaticResource FieldLabel}" Margin="0,20,0,6" />
                        <TextBox Text="{Binding SearchLimit, UpdateSourceTrigger=PropertyChanged}" Tag="300" Width="160" HorizontalAlignment="Left" />
                        <TextBlock Text="De 50 a 5000. O total encontrado sempre é informado; refine a pesquisa para chegar aos demais."
                                   Style="{StaticResource FieldHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra de ações fixa -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="40,14">
            <Grid MaxWidth="1120">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Há alterações não salvas." Foreground="{DynamicResource Brush.Warning}" FontSize="13" FontWeight="SemiBold"
                               Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Descartar" Style="{StaticResource Button.Secondary}" Command="{Binding DiscardCommand}" Margin="0,0,10,0" />
                    <Button Content="Salvar alterações" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
