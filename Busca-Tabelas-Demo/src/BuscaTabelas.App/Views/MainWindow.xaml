<Window x:Class="BuscaTabelas.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BuscaTabelas.App.ViewModels"
        xmlns:views="clr-namespace:BuscaTabelas.App.Views"
        xmlns:controls="clr-namespace:BuscaTabelas.App.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding AppName}"
        Icon="/Resources/Branding/app.ico"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Text}" FontSize="14"
        Foreground="{DynamicResource Brush.Text.Primary}"
        UseLayoutRounding="True"
        Closing="OnClosing">

    <Window.Resources>
        <!-- Cada ViewModel de página é exibido pela sua View -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CollectorViewModel}">
            <views:CollectorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Background="{DynamicResource Brush.Sidebar.Background}">
            <DockPanel>
                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,8,24">
                    <controls:BrandLogo Width="34" Height="34" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName}" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Versão de demonstração" Foreground="{DynamicResource Brush.Sidebar.TextMuted}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé: catálogo carregado (verde), nenhum catálogo (âmbar) ou carregando/coletando (laranja). A versão fica em Sobre. -->
                <Border DockPanel.Dock="Bottom" Padding="24,14" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Brush.Sidebar.Divider}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Sidebar.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SidebarStatus}" Value="Ready">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SidebarStatus}" Value="Missing">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SidebarStatus}" Value="Busy">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" Margin="9,0,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.Sidebar.Text}" />
                    </StackPanel>
                </Border>

                <!-- Menu em dois grupos: principal e SISTEMA -->
                <ListBox ItemsSource="{Binding NavigationView}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         Style="{StaticResource Sidebar.List}"
                         ItemContainerStyle="{StaticResource Sidebar.Item}"
                         AutomationProperties.Name="Menu principal">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Header" Text="{Binding Name}" Margin="24,20,24,8" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Sidebar.TextMuted}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="">
                                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="17" Width="20" />
                                <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Conteúdo da página -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
