<Window x:Class="BuscaTabelas.App.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:BuscaTabelas.App.Views.Dialogs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=dialogs:MessageDialogModel}"
        Title="{Binding Title}"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Text}" FontSize="14"
        Foreground="{DynamicResource Brush.Text.Primary}"
        UseLayoutRounding="True">

    <Grid Margin="20">
        <!-- Sombra separada do conteúdo para não desfocar o texto -->
        <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                MouseLeftButtonDown="OnDragAreaMouseDown">
            <StackPanel>
                <Grid Margin="28,28,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.InfoSubtle}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                        <Setter Property="Background" Value="{DynamicResource Brush.ErrorSubtle}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource Font.Icons}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" FontSize="17" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" LineHeight="21" />

                        <Expander Header="Ver detalhes técnicos" Style="{StaticResource Expander.Details}" Margin="-6,12,0,0"
                                  Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                     MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="6,0,0,0" />
                        </Expander>
                    </StackPanel>
                </Grid>

                <Border Margin="0,28,0,0" Padding="28,16" CornerRadius="0,0,12,12"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding CancelText}" Style="{StaticResource Button.Secondary}" IsCancel="True"
                                Margin="0,0,10,0" Click="OnCancelClick"
                                Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding ConfirmText}" Style="{StaticResource Button.Primary}" IsDefault="True"
                                Click="OnConfirmClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>

</Window>
