<UserControl x:Class="BuscaTabelas.App.Views.Controls.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20" IsHitTestVisible="False">
    <Grid>
        <Ellipse Stroke="{DynamicResource Brush.Track}" StrokeThickness="2.5" />
        <Ellipse Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2.5"
                 StrokeDashArray="7 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <RotateTransform />
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </Grid>
</UserControl>
