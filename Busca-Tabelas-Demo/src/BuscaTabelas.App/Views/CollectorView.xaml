<UserControl x:Class="BuscaTabelas.App.Views.CollectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BuscaTabelas.App.ViewModels"
             xmlns:collector="clr-namespace:BuscaTabelas.Core.Collector;assembly=BuscaTabelas.Core"
             xmlns:controls="clr-namespace:BuscaTabelas.App.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CollectorViewModel}"
             d:DesignWidth="1048" d:DesignHeight="1000">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Conexão encontrada no Windows: clicar preenche o campo -->
        <Style x:Key="SourceChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="999" Padding="12,5" BorderThickness="1"
                                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,34,40,28" MaxWidth="1120">
            <TextBlock Text="Atualizar catálogo" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Style="{StaticResource Text.PageSubtitle}"
                       Text="Exporta tabelas, colunas e descrições de um banco SQL Anywhere via ODBC. Somente metadados: nenhum registro é lido." />

            <!-- Modo demonstração: coletor desabilitado por padrão -->
            <Border Margin="0,24,0,0" CornerRadius="6" Padding="16,12" Background="{DynamicResource Brush.AccentSubtle}"
                    Visibility="{Binding IsCollectorDisabled, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="Exportação via ODBC desabilitada (modo demonstração)" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="A demo usa o catálogo fictício. Para exportar de um banco SQL Anywhere próprio, habilite o coletor em Configurações." />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Abrir catálogo de demonstração" Style="{StaticResource Button.Secondary}" FontSize="13"
                            Padding="14,7" VerticalAlignment="Center" Command="{Binding OpenDemoCatalogCommand}" />
                </Grid>
            </Border>

            <controls:AdaptiveWrapPanel Margin="0,24,0,0" Spacing="16" RowSpacing="16">
                <!-- Conexão -->
                <Border Style="{StaticResource Card}" controls:AdaptiveWrapPanel.Weight="1.6" MinWidth="440">
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Conexão" Style="{StaticResource Text.SectionTitle}" />

                        <TextBlock Text="Conexão ODBC (DSN)" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <TextBox Text="{Binding Dsn, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: DSN_EXEMPLO" AutomationProperties.Name="Conexão ODBC" />
                        <WrapPanel Margin="0,10,0,0" Visibility="{Binding HasDataSources, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Encontradas:" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,8" />
                            <ItemsControl ItemsSource="{Binding DataSources}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type collector:OdbcDataSource}">
                                        <Button Style="{StaticResource SourceChip}"
                                                Command="{Binding DataContext.UseDataSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding Driver}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                                <TextBlock Text="{Binding Platform}" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <TextBlock Text="O coletor usa o PowerShell de 32 bits: a conexão precisa existir em 32 bits."
                                   Style="{StaticResource FieldHint}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Usuário" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: USUARIO_EXEMPLO" AutomationProperties.Name="Usuário" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Esquema" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Schema, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: DBA" AutomationProperties.Name="Esquema" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap"
                                   Text="A senha é pedida na janela do PowerShell que abre ao testar ou exportar. Ela não é gravada nem passa pelo B.T." />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ExportCommand}" Padding="18,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource Text.Icon}" FontSize="16" />
                                    <TextBlock Text="Exportar catálogo" Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Content="Testar conexão" Style="{StaticResource Button.Secondary}" Command="{Binding TestConnectionCommand}"
                                    Margin="10,0,0,0" Padding="16,10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Somente leitura de metadados -->
                <Border Style="{StaticResource Card.Subtle}" controls:AdaptiveWrapPanel.Weight="1" MinWidth="300" Padding="22,20">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="19" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <TextBlock Text="Somente metadados" Style="{StaticResource Text.CardTitle}" Margin="0,14,0,0" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" LineHeight="20" TextWrapping="Wrap"
                                   Text="O coletor executa apenas SELECTs fixos no catálogo de sistema (SYS.SYSTABLE, SYS.SYSCOLUMN e SYS.SYSDOMAIN). Use um usuário com permissão somente de leitura." />
                        <TextBlock Text="COMO HABILITAR" Style="{StaticResource Text.Overline}" Margin="0,16,0,6" />
                        <TextBlock Style="{StaticResource Text.Secondary}" LineHeight="21" TextWrapping="Wrap">
                            <Run Text="1. Abra Configurações › Coletor ODBC." /><LineBreak />
                            <Run Text="2. Marque" /> <Run Text="Habilitar exportação via ODBC" FontWeight="SemiBold" /><Run Text="." /><LineBreak />
                            <Run Text="3. Informe a conexão (DSN), o usuário e o esquema." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </controls:AdaptiveWrapPanel>

            <!-- Em andamento -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,16" BorderBrush="{DynamicResource Brush.Accent}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <controls:Spinner Width="22" Height="22" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RunningText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        <TextBlock Text="Ao terminar, pressione Enter na janela do PowerShell para voltar ao B.T." Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Resultado -->
            <Border Margin="0,16,0,0" CornerRadius="6" Padding="16,12" Visibility="{Binding Message, Converter={StaticResource EmptyToCollapsed}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSubtle}" />
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageKind}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource Brush.WarningSubtle}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Warning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="15">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                                <Setter Property="Text" Value="&#xE73E;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageKind}" Value="Warning">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="10,0" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Width="28" Height="28" Padding="0"
                            Command="{Binding DismissMessageCommand}" ToolTip="Fechar" AutomationProperties.Name="Fechar mensagem">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Text.Icon}" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Exportações -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="22,18,22,6">
                        <StackPanel>
                            <TextBlock Text="Catálogos exportados" Style="{StaticResource Text.SectionTitle}" />
                            <TextBlock Text="{Binding CatalogsFolder}" Style="{StaticResource Text.Caption}" FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource Button.Ghost}" FontSize="13" Command="{Binding BrowseCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Text.Icon}" FontSize="14" />
                                    <TextBlock Text="Abrir arquivo…" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" FontSize="13" Padding="12,7" Margin="6,0,0,0"
                                    Command="{Binding OpenCatalogsFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xED25;" Style="{StaticResource Text.Icon}" FontSize="14" />
                                    <TextBlock Text="Abrir pasta" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Catalogs}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CatalogFileItem}">
                                <Border BorderBrush="{DynamicResource Brush.SurfaceHover}" BorderThickness="0,1,0,0" Padding="22,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEE94;" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{DynamicResource Brush.SuccessSubtle}"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                                                <TextBlock Text="Em uso" Margin="6,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="2" Content="Abrir" Style="{StaticResource Button.Secondary}" FontSize="13" Padding="14,6"
                                                Command="{Binding DataContext.OpenCatalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="28"
                            Visibility="{Binding HasCatalogs, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xEE94;" Style="{StaticResource Text.Icon}" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.BorderStrong}" />
                            <TextBlock Text="Nenhuma exportação nesta pasta" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="As exportações aparecerão aqui, da mais recente para a mais antiga." Style="{StaticResource Text.Caption}"
                                       FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Height="8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
